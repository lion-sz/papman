Screen {
    layout: grid;
    grid-size: 2;
    grid-columns: 25% 75%;
}

#main-sidebar {
    layout: vertical;
    height: 1fr;
    background: $primary-background;
    border-right: $primary;
    padding: 0 1;
}

#main {
    height: 1fr;
}

PapersModule,
CollectionPanel,
ReadingListPanel {
    layout: vertical;
    height: 1fr;
}

.paper-item{
    height: 4;
}

.paper-item-grid{
    layout: grid;
    grid-size: 4 3;
    grid-columns: 20% 30% 20% 30%;
}

.paper-item-label{
    width: 100%;
    padding: 0;
    text-overflow: clip;
    text-wrap: nowrap;
    height: 1;
}

.paper-title {
    column-span: 3;
}

.paper-author {
    column-span: 2;
}

.paper-tags {
    column-span: 3;
}

.modal {
    layout: vertical;
    align: center middle;
}

.modal-content {
    border: thick $background;
    background: $surface;
    width: 80%;
    height: 80%;
    min-height: 0;
}

.dialog-content {
    border: thick $background;
    background: $surface;
    width: 40%;
    height: 20%;
    align: center middle;
    opacity: 0.8;
}

.error {
    background: #840000;
}

.entry-edit-screen {
    padding: 1 2;
    overflow-y: auto;
}

.entry-edit-screen Label {
    margin-top: 1;
}

.entry-edit-screen Input {
    width: 100%;
}

.entry-edit-screen TextArea {
    width: 100%;
    height: 1fr;
    margin-top: 1;
}

.entry-edit-actions {
    margin-top: 2;
    align-horizontal: right;
    width: 100%;
}
