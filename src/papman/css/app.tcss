Screen {
    layout: grid;
    grid-size: 2;
    grid-columns: 25% 75%;
}

.sidebar {
    height: 100%;
    background: $primary-background;
    border-right: $primary;
    border-bottom: $primary;
}

#main {
    row-span: 2;
    column-span: 2;
    border: solid green;
    height: 100%;
}

.paper-item {
    height: 2;
}

.paper-two-line {
    height: 3;
}

.paper-item-elem {
    layout: grid;
    grid-size: 3 2;
    grid-columns: 50% 20% 30%;
}

.paper-title {
    column-span: 3;
}

.paper-elem {
    width: 100%;
    padding: 0;
    overflow: hidden;
}

.modal {
    layout: vertical;
    align: center middle;
}

.modal-content {
    border: thick $background;
    background: $surface;
    width: 80%;
    height: 80%;
}

.dialog-content {
    border: thick $background;
    background: $surface;
    width: 40%;
    height: 20%;
    align: center middle;
    opacity: 0.8;
}

.error {
    background: #840000;
}

.box {
    border: solid green;
}

.entry-edit-screen {
    padding: 1 2;
    overflow-y: auto;
}

.entry-edit-screen Label {
    margin-top: 1;
}

.entry-edit-screen Input {
    width: 100%;
}

.entry-edit-screen TextArea {
    width: 100%;
    height: 1fr;
    margin-top: 1;
}

.entry-edit-meta {
    color: $text-muted;
}

.entry-edit-actions {
    margin-top: 2;
    align-horizontal: right;
    width: 100%;
}
