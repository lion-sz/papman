Screen {
    layout: grid;
    grid-size: 2;
    grid-columns: 25% 75%;
}

.sidebar {
    layout: vertical;
    height: 100%;
    background: $primary-background;
    border-right: $primary;
    border-bottom: $primary;
}

#reading-lists-body {
    height: 1fr;
    padding: 0 1;
}

#reading-lists-list {
    background: $primary-background;
    border: none;
}

#reading-lists-list > ListItem {
    background: $primary-background;
}

#new-reading-list {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0 0 1 0;
    align-horizontal: center;
    padding: 0 1;
    background: transparent;
    border: none;
}

#main {
    row-span: 2;
    column-span: 2;
    height: 100%;
}

.paper-item{
    height: 4;
}

.paper-item-grid{
    layout: grid;
    grid-size: 4 3;
    grid-columns: 20% 30% 20% 30%;
}

.paper-item-label{
    width: 100%;
    padding: 0;
    text-overflow: clip;
    text-wrap: nowrap;
    height: 1;
}

.paper-title {
    column-span: 3;
}

.paper-author {
    column-span: 2;
}

.paper-tags {
    column-span: 3;
}

.modal {
    layout: vertical;
    align: center middle;
}

.modal-content {
    border: thick $background;
    background: $surface;
    width: 80%;
    height: 80%;
}

.dialog-content {
    border: thick $background;
    background: $surface;
    width: 40%;
    height: 20%;
    align: center middle;
    opacity: 0.8;
}

.error {
    background: #840000;
}

.box {
    border: solid green;
}

.entry-edit-screen {
    padding: 1 2;
    overflow-y: auto;
}

.entry-edit-screen Label {
    margin-top: 1;
}

.entry-edit-screen Input {
    width: 100%;
}

.entry-edit-screen TextArea {
    width: 100%;
    height: 1fr;
    margin-top: 1;
}

.entry-edit-meta {
    color: $text-muted;
}

.entry-edit-actions {
    margin-top: 2;
    align-horizontal: right;
    width: 100%;
}

#search-modal {
    padding: 1 2;
}

#search-results {
    height: 1fr;
    margin-top: 1;
    margin-bottom: 1;
}

#search-query {
    dock: bottom;
}
